<!-- Web Search -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Web Search (Google Custom Search)"
                android:textColor="#F5C518"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/etSearchApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="Search API Key (AIza…)"
                android:textColor="#F5F5F5"
                android:textColorHint="#666666"
                android:background="#1A1A1A"
                android:padding="12dp" />

            <CheckBox
                android:id="@+id/cbShowSearchApiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show key"
                android:textColor="#A0A0A0" />

            <EditText
                android:id="@+id/etSearchCx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="Search Engine ID (cx)"
                android:textColor="#F5F5F5"
                android:textColorHint="#666666"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- Gmail -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gmail"
                android:textColor="#F5C518"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tvGmailStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not connected"
                android:textColor="#A0A0A0"
                android:background="#1A1A1A"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnConnectGmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect Gmail"
                android:layout_marginTop="8dp" />

            <!-- Offline AI Model -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Offline AI Model"
                android:textColor="#F5C518"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tvOfflineModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No offline model loaded"
                android:textColor="#A0A0A0"
                android:background="#1A1A1A"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSelectOfflineModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select model file (.task)"
                android:layout_marginTop="8dp" />

            <!-- Health Connect -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Health Connect (smartwatch data)"
                android:textColor="#F5C518"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tvHealthStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not connected"
                android:textColor="#A0A0A0"
                android:background="#1A1A1A"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnConnectHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect Health Connect"
                android:layout_marginTop="8dp" />

            <!-- Box 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/box2_messaging"
                android:textColor="#F5C518"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/etWhatsapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="WhatsApp Business token"
                android:textColor="#F5F5F5"
                android:textColorHint="#666666"
                android:background="#1A1A1A"
                android:padding="12dp" />

            <EditText
                android:id="@+id/etMail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="Gmail / Mail token"
                android:textColor="#F5F5F5"
                android:textColorHint="#666666"
                android:background="#1A1A1A"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- Box 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/box3_lock"
                android:textColor="#F5C518"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Active · password gate enabled\nCloses when you leave Settings."
                android:textColor="#22C55E"
                android:background="#1A1A1A"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
